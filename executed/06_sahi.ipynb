{'cells': [{'cell_type': 'markdown', 'id': '08b44691', 'metadata': {'papermill': {'duration': 0.001372, 'end_time': '2026-09-26T11:22:46.269339+00:00', 'exception': False, 'start_time': '2026-09-26T11:22:46.267967+00:00', 'status': 'completed'}, 'tags': []}, 'source': "# 06 — Intervention D: sliced inference (SAHI)\n\nInference only, on the **baseline weights** (notebook 02) — no retraining. Each native 1920×1080 frame is tiled, every tile is detected at imgsz 640, and tile detections are merged with a full-frame pass by NMS. Tiles see the ball at native resolution instead of 3× downscaled.\n\n- **Slice size is chosen on val** (640 or 960 native px, by ball mAP50-95), then reported on test once.\n- **Same metric code as every other run.** SAHI boxes are scored by `bc.evaluate_predictions`, which reuses ultralytics' own matching and `ap_per_class`. The first check proves it: plain full-frame predictions through that evaluator must reproduce `model.val()` on test.\n- Scale caveat for the report: the baseline was trained on 3× downscaled frames, so objects in native tiles look larger than anything it saw in training (scale jitter covers only 0.5–1.5×). That mismatch is part of what this measures.\n- FPS is timed at the normal confidence threshold 0.25; scoring uses 0.001 like `model.val()`."}, {'cell_type': 'code', 'execution_count': 1, 'id': 'b2c6c814', 'metadata': {'execution': {'iopub.execute_input': '2026-09-26T11:22:46.272725Z', 'iopub.status.busy': '2026-09-26T11:22:46.272432Z', 'iopub.status.idle': '2026-09-26T11:22:46.276326Z', 'shell.execute_reply': '2026-09-26T11:22:46.275619Z'}, 'papermill': {'duration': 0.007083, 'end_time': '2026-09-26T11:22:46.277680+00:00', 'exception': False, 'start_time': '2026-09-26T11:22:46.270597+00:00', 'status': 'completed'}, 'tags': ['parameters'], 'trusted': False}, 'outputs': [], 'source': 'SMOKE = False  # True: only the first slice size, written to <run_name>_smoke\nBASELINE_WEIGHTS = "/content/results/baseline_yolo11s_640/best.pt"\nSLICE_SIZES = [640, 960]\nOVERLAP = 0.2'}, {'cell_type': 'code', 'execution_count': 2, 'id': '8bd7def9', 'metadata': {'execution': {'iopub.execute_input': '2026-09-26T11:22:46.281114Z', 'iopub.status.busy': '2026-09-26T11:22:46.280643Z', 'iopub.status.idle': '2026-09-26T11:22:50.902556Z', 'shell.execute_reply': '2026-09-26T11:22:50.901954Z'}, 'papermill': {'duration': 4.626865, 'end_time': '2026-09-26T11:22:50.905602+00:00', 'exception': False, 'start_time': '2026-09-26T11:22:46.278737+00:00', 'status': 'completed'}, 'tags': [], 'trusted': False}, 'outputs': [], 'source': 'import subprocess, sys\nsubprocess.run([sys.executable, "-m", "pip", "install", "-q", "sahi"], check=True)\nsys.path.insert(0, "/content/ballhawk")\nimport pandas as pd\nimport ballhawk_common as bc\nfrom ultralytics import YOLO\nfrom sahi import AutoDetectionModel\nfrom sahi.predict import get_sliced_prediction\n\ndata_yaml = bc.prepare_data()\nif SMOKE:\n    SLICE_SIZES = SLICE_SIZES[:1]'}, {'cell_type': 'code', 'execution_count': 3, 'id': '2876c570', 'metadata': {'execution': {'iopub.execute_input': '2026-09-26T11:22:50.910284Z', 'iopub.status.busy': '2026-09-26T11:22:50.909818Z', 'iopub.status.idle': '2026-09-26T11:22:57.213568Z', 'shell.execute_reply': '2026-09-26T11:22:57.212615Z'}, 'papermill': {'duration': 6.308011, 'end_time': '2026-09-26T11:22:57.215292+00:00', 'exception': False, 'start_time': '2026-09-26T11:22:50.907281+00:00', 'status': 'completed'}, 'tags': [], 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': 'Ultralytics 8.4.163 🚀 Python-3.13.15 torch-2.11.0+cu128 CUDA:0 (Tesla T4, 14913MiB)\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': 'YOLO11s summary (fused): 100 layers, 9,414,348 parameters, 0 gradients, 21.4 GFLOPs\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\x1b[34m\x1b[1mval: \x1b[0mFast image access ✅ (ping: 0.0±0.0 ms, read: 3588.8±1056.7 MB/s, size: 222.4 KB)\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\r\x1b[K\x1b[34m\x1b[1mval: \x1b[0mScanning /content/data/test/labels.cache... 72 images, 0 backgrounds, 0 corrupt: 100% ━━━━━━━━━━━━ 72/72 12.6Mit/s 0.0s'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\r\x1b[K                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95): 20% ━━────────── 1/5 2.3s/it 0.7s<9.2s'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\r\x1b[K                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95): 40% ━━━━╸─────── 2/5 1.8it/s 0.9s<1.6s'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\r\x1b[K                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95): 60% ━━━━━━━───── 3/5 3.0it/s 1.1s<0.7s'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\r\x1b[K                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95): 80% ━━━━━━━━━╸── 4/5 3.6it/s 1.3s<0.3s'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\r\x1b[K                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95): 100% ━━━━━━━━━━━━ 5/5 3.5it/s 1.4s'}, {'name': 'stdout', 'output_type': 'stream', 'text': '\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '                   all         72       1713      0.817       0.75      0.746      0.509\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': 'Speed: 0.9ms preprocess, 7.5ms inference, 0.0ms loss, 1.9ms postprocess per image\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': "evaluator: {'mAP50': 0.7375526811913213, 'mAP50_95': 0.5000700897604686} \nmodel.val: {'mAP50': 0.7459270250994895, 'mAP50_95': 0.5088824276125882}\n"}], 'source': '# Evaluator check: full-frame predictions through bc.evaluate_predictions vs model.val() on test.\nmodel = YOLO(BASELINE_WEIGHTS)\ndef full_frame(img):\n    b = model.predict(img, imgsz=640, conf=0.001, iou=0.7, max_det=300, verbose=False)[0].boxes\n    return b.xyxy.cpu().numpy(), b.conf.cpu().numpy(), b.cls.cpu().numpy()\nours, ours_pc = bc.evaluate_predictions({p: full_frame(p) for p in bc.split_images(data_yaml, "test")}, data_yaml, "test")\nref, ref_pc = bc.evaluate_test(BASELINE_WEIGHTS, data_yaml, 640)\nprint("evaluator:", ours, "\\nmodel.val:", ref)\nassert abs(ours["mAP50"] - ref["mAP50"]) < 0.02, "evaluator does not reproduce model.val(); SAHI numbers would not be comparable"'}, {'cell_type': 'code', 'execution_count': 4, 'id': 'fce721de', 'metadata': {'execution': {'iopub.execute_input': '2026-09-26T11:22:57.221062Z', 'iopub.status.busy': '2026-09-26T11:22:57.220184Z', 'iopub.status.idle': '2026-09-26T11:23:23.555526Z', 'shell.execute_reply': '2026-09-26T11:23:23.554766Z'}, 'papermill': {'duration': 26.340157, 'end_time': '2026-09-26T11:23:23.557427+00:00', 'exception': False, 'start_time': '2026-09-26T11:22:57.217270+00:00', 'status': 'completed'}, 'tags': [], 'trusted': False}, 'outputs': [{'name': 'stderr', 'output_type': 'stream', 'text': '\x1b[33;20m2026-09-26 11:23:09,865 - sahi - WARNING - ignoring invalid prediction with bbox: [0, 0, 12.873564720153809, 0] (ultralytics.py:285)\x1b[0m\n'}, {'name': 'stderr', 'output_type': 'stream', 'text': 'WARNING:sahi:ignoring invalid prediction with bbox: [0, 0, 12.873564720153809, 0]\n'}, {'name': 'stderr', 'output_type': 'stream', 'text': '\x1b[33;20m2026-09-26 11:23:23,265 - sahi - WARNING - ignoring invalid prediction with bbox: [0, 0, 12.873564720153809, 0] (ultralytics.py:285)\x1b[0m\n'}, {'name': 'stderr', 'output_type': 'stream', 'text': 'WARNING:sahi:ignoring invalid prediction with bbox: [0, 0, 12.873564720153809, 0]\n'}, {'data': {'text/html': '\n  <div id="df-ec845873-892a-4b22-963e-6635515f7570" class="colab-df-container">\n    <div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border="1" class="dataframe">\n  <thead>\n    <tr style="text-align: right;">\n      <th></th>\n      <th>slice</th>\n      <th>val_mAP50_95</th>\n      <th>val_ball_mAP50_95</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>640</td>\n      <td>0.495467</td>\n      <td>0.166176</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>960</td>\n      <td>0.557497</td>\n      <td>0.192718</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n    <div class="colab-df-buttons">\n      \n  <div class="colab-df-container">\n    <button class="colab-df-convert" onclick="convertToInteractive(\'df-ec845873-892a-4b22-963e-6635515f7570\')"\n            title="Convert this dataframe to an interactive table."\n            style="display:none;">\n      \n  <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960">\n    <path d="M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z"/>\n  </svg>\n    </button>\n    \n  <style>\n    .colab-df-container {\n      display:flex;\n      gap: 12px;\n    }\n\n    .colab-df-convert {\n      background-color: #E8F0FE;\n      border: none;\n      border-radius: 50%;\n      cursor: pointer;\n      display: none;\n      fill: #1967D2;\n      height: 32px;\n      padding: 0 0 0 0;\n      width: 32px;\n    }\n\n    .colab-df-convert:hover {\n      background-color: #E2EBFA;\n      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n      fill: #174EA6;\n    }\n\n    .colab-df-buttons div {\n      margin-bottom: 4px;\n    }\n\n    [theme=dark] .colab-df-convert {\n      background-color: #3B4455;\n      fill: #D2E3FC;\n    }\n\n    [theme=dark] .colab-df-convert:hover {\n      background-color: #434B5C;\n      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n      fill: #FFFFFF;\n    }\n  </style>\n\n    <script>\n      const buttonEl =\n        document.querySelector(\'#df-ec845873-892a-4b22-963e-6635515f7570 button.colab-df-convert\');\n      buttonEl.style.display =\n        google.colab.kernel.accessAllowed ? \'block\' : \'none\';\n\n      async function convertToInteractive(key) {\n        const element = document.querySelector(\'#df-ec845873-892a-4b22-963e-6635515f7570\');\n        const dataTable =\n          await google.colab.kernel.invokeFunction(\'convertToInteractive\',\n                                                    [key], {});\n        if (!dataTable) return;\n\n        const docLinkHtml = \'Like what you see? Visit the \' +\n          \'<a target="_blank" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>\'\n          + \' to learn more about interactive tables.\';\n        element.innerHTML = \'\';\n        dataTable[\'output_type\'] = \'display_data\';\n        await google.colab.output.renderOutput(dataTable, element);\n        const docLink = document.createElement(\'div\');\n        docLink.innerHTML = docLinkHtml;\n        element.appendChild(docLink);\n      }\n    </script>\n  </div>\n  \n    </div>\n  </div>\n  ', 'text/plain': '   slice  val_mAP50_95  val_ball_mAP50_95\n0    640      0.495467           0.166176\n1    960      0.557497           0.192718'}, 'execution_count': 4, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'def sahi_model(conf):\n    return AutoDetectionModel.from_pretrained(model_type="ultralytics", model_path=BASELINE_WEIGHTS,\n                                              confidence_threshold=conf, device="cuda:0", image_size=640)\n\ndef sahi_predict(dm, img, size):\n    return get_sliced_prediction(str(img), dm, slice_height=size, slice_width=size,\n                                 overlap_height_ratio=OVERLAP, overlap_width_ratio=OVERLAP,\n                                 perform_standard_pred=True, postprocess_type="NMS",\n                                 postprocess_match_metric="IOU", postprocess_match_threshold=0.5, verbose=0)\n\ndef sahi_arrays(dm, img, size):\n    ops = sahi_predict(dm, img, size).object_prediction_list\n    return ([op.bbox.to_xyxy() for op in ops], [op.score.value for op in ops], [op.category.id for op in ops])\n\ndef ball(per_class):\n    return next(c for c in per_class if c["class"] == "ball")\n\nscore_dm = sahi_model(0.001)\nsweep = []\nfor size in SLICE_SIZES:\n    ov, pc = bc.evaluate_predictions({p: sahi_arrays(score_dm, p, size) for p in bc.split_images(data_yaml, "val")},\n                                     data_yaml, "val")\n    sweep.append({"slice": size, "val_mAP50_95": ov["mAP50_95"], "val_ball_mAP50_95": ball(pc)["mAP50_95"]})\nsweep = pd.DataFrame(sweep); sweep'}, {'cell_type': 'code', 'execution_count': 5, 'id': '540afe0a', 'metadata': {'execution': {'iopub.execute_input': '2026-09-26T11:23:23.563198Z', 'iopub.status.busy': '2026-09-26T11:23:23.562580Z', 'iopub.status.idle': '2026-09-26T11:23:51.322045Z', 'shell.execute_reply': '2026-09-26T11:23:51.321308Z'}, 'papermill': {'duration': 27.76395, 'end_time': '2026-09-26T11:23:51.323627+00:00', 'exception': False, 'start_time': '2026-09-26T11:23:23.559677+00:00', 'status': 'completed'}, 'tags': [], 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '/content/results/sahi_baseline_s960/metrics.json\n'}], 'source': 'best = int(sweep.loc[sweep.val_ball_mAP50_95.idxmax(), "slice"])\noverall, per_class = bc.evaluate_predictions(\n    {p: sahi_arrays(score_dm, p, best) for p in bc.split_images(data_yaml, "test")}, data_yaml, "test")\ntime_dm = sahi_model(0.25)\nfps = bc.measure_fps(None, data_yaml, 640, predict=lambda p: sahi_predict(time_dm, p, best))\n\nrun_name = f"sahi_baseline_s{best}" + ("_smoke" if SMOKE else "")\nrecord = {\n    "run_name": run_name, "notebook": "06",\n    "variable_changed": f"sliced inference: {best}px native slices, overlap {OVERLAP}, + full-frame pass, NMS merge",\n    "model": "baseline_yolo11s_640 best.pt", "imgsz": 640, "epochs": 100, "batch": 16, "split": "test",\n    "overall": overall, "per_class": per_class, "inference_fps": fps, "train_minutes": 0.0,\n    "notes": (f"Inference only on 02 weights. Slice size chosen on val from {SLICE_SIZES} by ball mAP50-95. "\n              f"Evaluator check on test, full-frame: bc.evaluate_predictions mAP50 {ours[\'mAP50\']:.4f} vs "\n              f"model.val {ref[\'mAP50\']:.4f}. ultralytics 8.4.163."),\n}\nprint(bc.write_metrics(record, bc.RESULTS_DIR / run_name))'}, {'cell_type': 'code', 'execution_count': 6, 'id': 'd22bf7a6', 'metadata': {'execution': {'iopub.execute_input': '2026-09-26T11:23:51.329041Z', 'iopub.status.busy': '2026-09-26T11:23:51.328359Z', 'iopub.status.idle': '2026-09-26T11:23:51.340396Z', 'shell.execute_reply': '2026-09-26T11:23:51.339731Z'}, 'papermill': {'duration': 0.016603, 'end_time': '2026-09-26T11:23:51.342276+00:00', 'exception': False, 'start_time': '2026-09-26T11:23:51.325673+00:00', 'status': 'completed'}, 'tags': [], 'trusted': False}, 'outputs': [{'data': {'text/html': '\n  <div id="df-3f2c865c-c9fe-4f3a-8422-f221c6b84f83" class="colab-df-container">\n    <div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border="1" class="dataframe">\n  <thead>\n    <tr style="text-align: right;">\n      <th></th>\n      <th>full_frame</th>\n      <th>sahi_960</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>ball</th>\n      <td>0.113</td>\n      <td>0.188</td>\n    </tr>\n    <tr>\n      <th>goalkeeper</th>\n      <td>0.579</td>\n      <td>0.621</td>\n    </tr>\n    <tr>\n      <th>player</th>\n      <td>0.736</td>\n      <td>0.759</td>\n    </tr>\n    <tr>\n      <th>referee</th>\n      